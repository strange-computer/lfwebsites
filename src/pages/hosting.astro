---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Managed Hosting | Lake Forest Websites" bodyClass="page-hosting">
  <link rel="stylesheet" href="/css/pages/hosting.css" />

  <!-- Hero -->
  <header class="relative pt-32 md:pt-40 pb-12 md:pb-16 px-4 md:px-6 text-center">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] glow-bg pointer-events-none opacity-40"></div>
    <div class="max-w-5xl mx-auto relative">
      <div class="hero-content inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-medium text-orange-400 mb-6 backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
        Managed Hosting
      </div>
      <h1 class="hero-content text-3xl md:text-6xl font-bold tracking-tight mb-4 text-balance" style="animation-delay: 0.1s">
        Fast, Secure <span class="text-gradient-orange">& Reliable</span>
      </h1>
      <p class="hero-content text-zinc-400 text-base md:text-lg leading-relaxed px-2 md:px-0" style="animation-delay: 0.2s">
        Fully managed hosting so your website runs fast, stays secure, and doesn’t get in the way of your business.
      </p>
    </div>
  </header>

  <main class="pb-16 md:pb-24 px-4 md:px-6">
    <!-- No downtime, no headaches -->
    <section class="max-w-7xl mx-auto border-t border-white/5 pt-8 md:pt-12 mesh-gradient py-8 md:py-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-4 md:mb-6 fade-in-up text-balance">No Downtime. No Headaches.</h2>
      <div class="grid md:grid-cols-3 gap-4 md:gap-6">
        <div class="framer-card p-8 rounded-2xl fade-in-up stagger-1 group">
          <div class="w-10 h-10 rounded-xl bg-orange-500/15 border border-orange-500/20 flex items-center justify-center mb-4 group-hover:bg-orange-500/25 group-hover:scale-110 transition-all">
            <svg class="w-5 h-5 text-orange-400 group-hover:text-orange-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18M3 12h18M3 17h18"/></svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Premium Cloud Servers</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Environments tuned to your site—no noisy neighbors or generic, oversold plans.</p>
        </div>
        <div class="framer-card p-8 rounded-2xl fade-in-up stagger-2 group">
          <div class="w-10 h-10 rounded-xl bg-orange-500/15 border border-orange-500/20 flex items-center justify-center mb-4 group-hover:bg-orange-500/25 group-hover:scale-110 transition-all">
            <svg class="w-5 h-5 text-orange-400 group-hover:text-orange-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6"/></svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Optimized for Performance</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Modern hardware, SSD storage, caching, and resource tuning for speed and reliability.</p>
        </div>
        <div class="framer-card p-8 rounded-2xl fade-in-up stagger-3 group relative overflow-hidden uptime-monitoring-card">
          <!-- Video Background -->
          <video class="absolute inset-0 -z-10 uptime-video-bg" muted loop playsinline>
            <source src="/videos/BeautifulCodeFACE.mp4" type="video/mp4">
          </video>
          <!-- Dark overlay with orange tint for brand consistency -->
          <div class="absolute inset-0 -z-10 bg-gradient-to-b from-black/60 via-black/50 to-black/60"></div>
          <div class="absolute inset-0 -z-10 bg-gradient-to-br from-orange-950/12 via-transparent to-purple-950/8"></div>
          <!-- Content wrapper with relative positioning -->
          <div class="relative z-10">
            <div class="w-10 h-10 rounded-xl bg-orange-500/15 border border-orange-500/20 flex items-center justify-center mb-4 group-hover:bg-orange-500/25 group-hover:scale-110 transition-all">
              <svg class="w-5 h-5 text-orange-400 group-hover:text-orange-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="text-xl font-semibold mb-2">24/7 Uptime Monitoring</h3>
            <p class="text-sm text-zinc-400 leading-relaxed">We watch your site around the clock and fix issues before they impact customers.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Optimized & Security -->
    <section class="max-w-7xl mx-auto mt-12">
      <div class="grid md:grid-cols-2 gap-4 md:gap-6">
        <div class="framer-card p-8 rounded-2xl">
          <h3 class="text-xl font-semibold mb-2">Optimized for Business</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">We don’t resell generic hosting. Your site runs on a managed cloud environment built for small and mid‑sized businesses.</p>
        </div>
        <div class="framer-card p-8 rounded-2xl">
          <h3 class="text-xl font-semibold mb-2">Security You Can Count On</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Updates, patches, and sensible hardening keep your stack stable and secure—without slowing the site down.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="max-w-7xl mx-auto mt-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-6">Frequently Asked Questions</h2>
      <div class="grid md:grid-cols-2 gap-4 md:gap-6">
        <div class="framer-card p-6 rounded-2xl">
          <h3 class="font-semibold mb-2">Are you just reselling hosting?</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">No. We operate and manage our own cloud servers, so we control performance and security.</p>
        </div>
        <div class="framer-card p-6 rounded-2xl">
          <h3 class="font-semibold mb-2">Can I use my own provider?</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Yes. We’ll recommend what’s best, but we can deploy to third‑party hosts if that’s preferred.</p>
        </div>
        <div class="framer-card p-6 rounded-2xl">
          <h3 class="font-semibold mb-2">Will my site be secure?</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">We include sensible firewalls, malware scanning, and regular updates. Security without gimmicks.</p>
        </div>
        <div class="framer-card p-6 rounded-2xl">
          <h3 class="font-semibold mb-2">What happens if the site goes down?</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">We monitor uptime 24/7 and respond quickly to restore service and find the root cause.</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="text-center mt-12 md:mt-16 border-t border-white/5 pt-8 md:pt-12 mesh-gradient py-8 md:py-12 fade-in-up">
      <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
        <a href="/contact" class="w-full sm:w-auto px-8 md:px-10 py-4 md:py-5 bg-orange-600 text-white font-bold rounded-full hover:bg-orange-500 transition-all text-base md:text-lg btn-glow relative hover:scale-105 min-h-[44px] flex items-center justify-center">
          Talk to our team
        </a>
        <a href="/services" class="w-full sm:w-auto px-8 md:px-10 py-4 md:py-5 bg-white/5 text-white font-bold rounded-full border border-white/10 hover:bg-white/10 transition-all hover:border-white/20 text-base md:text-lg min-h-[44px] flex items-center justify-center">
          Explore services
        </a>
      </div>
      <p class="text-zinc-500 text-sm mt-3 text-balance">Prefer a call? Add your number in the email.</p>
    </section>
  </main>
</MainLayout>

<script>
  // Handle video play on hover for uptime monitoring card
  document.addEventListener('DOMContentLoaded', () => {
    const uptimeCard = document.querySelector('.uptime-monitoring-card');
    const uptimeVideo = document.querySelector('.uptime-video-bg');
    
    if (uptimeCard && uptimeVideo) {
      // Pause video initially
      uptimeVideo.pause();
      
      // Play video on hover
      uptimeCard.addEventListener('mouseenter', () => {
        uptimeVideo.play().catch(err => {
          // Handle autoplay restrictions
          console.log('Video play prevented:', err);
        });
      });
      
      // Pause video when mouse leaves
      uptimeCard.addEventListener('mouseleave', () => {
        uptimeVideo.pause();
      });
    }
  });
</script>


