---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Portfolio | Lake Forest Websites" bodyClass="page-portfolio">
  <link rel="stylesheet" href="/css/pages/portfolio.css" />

  <!-- Hero -->
  <header class="relative pt-32 md:pt-40 pb-12 md:pb-16 px-4 md:px-6 text-center">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] glow-bg pointer-events-none opacity-40"></div>
    <div class="max-w-5xl mx-auto relative">
      <div class="hero-content inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-medium text-orange-400 mb-6 backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
        Portfolio
      </div>
      <h1 class="hero-content text-3xl md:text-6xl font-bold tracking-tight mb-4 text-balance" style="animation-delay: 0.1s">
        Selected <span class="text-gradient-orange">Work</span>
      </h1>
      <p class="hero-content text-zinc-400 text-base md:text-lg leading-relaxed px-2 md:px-0" style="animation-delay: 0.2s">
        A handful of recent builds. Each site is tailored to goals, content, and audience—no templates.
      </p>
    </div>
  </header>

  <main class="pb-16 md:pb-24 px-4 md:px-6">
    <!-- Featured projects -->
    <section class="max-w-7xl mx-auto border-t border-white/5 pt-8 md:pt-12">
      <div class="grid md:grid-cols-3 gap-4 md:gap-6">
        {Array.from({ length: 6 }).map((_, i) => (
          <div class={`framer-card p-4 rounded-2xl group overflow-hidden fade-in-up ${i % 3 === 0 ? 'stagger-1' : i % 3 === 1 ? 'stagger-2' : 'stagger-3'}`}>
            {i === 0 ? (
              <div class="relative h-52 rounded-xl border border-white/10 mb-4 overflow-hidden">
                <img src="/images/honkpill.com_.png" alt="Honkpill product site preview" class="w-full h-full object-cover object-top" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-br from-zinc-900/40 to-zinc-900/10 opacity-80 group-hover:opacity-40 transition-opacity"></div>
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(251,146,60,0.12),transparent_40%)] opacity-80 group-hover:opacity-40 transition-opacity"></div>
              </div>
            ) : i === 1 ? (
              <div class="relative h-52 rounded-xl border border-white/10 mb-4 overflow-hidden">
                <img src="/images/realestate.png" alt="Real Estate site preview" class="w-full h-full object-cover object-top" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-br from-zinc-900/40 to-zinc-900/10 opacity-80 group-hover:opacity-40 transition-opacity"></div>
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(251,146,60,0.12),transparent_40%)] opacity-80 group-hover:opacity-40 transition-opacity"></div>
              </div>
            ) : i === 2 ? (
              <div class="relative h-52 rounded-xl border border-white/10 mb-4 overflow-hidden">
                <img src="/images/temptingdesign.com_.png" alt="Tempting Design site preview" class="w-full h-full object-cover object-top" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-br from-zinc-900/40 to-zinc-900/10 opacity-80 group-hover:opacity-40 transition-opacity"></div>
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(251,146,60,0.12),transparent_40%)] opacity-80 group-hover:opacity-40 transition-opacity"></div>
              </div>
            ) : i === 3 ? (
              <div class="relative h-52 rounded-xl border border-white/10 mb-4 overflow-hidden">
                <img src="/images/mint.gondolaadventureclub.com_.png" alt="Gondola Adventure Club Mint preview" class="w-full h-full object-cover object-top" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-br from-zinc-900/40 to-zinc-900/10 opacity-80 group-hover:opacity-40 transition-opacity"></div>
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(251,146,60,0.12),transparent_40%)] opacity-80 group-hover:opacity-40 transition-opacity"></div>
              </div>
            ) : i === 4 ? (
              <div class="relative h-52 rounded-xl border border-white/10 mb-4 overflow-hidden">
                <img src="/images/houghchiropractic.png" alt="Hough Chiropractic site preview" class="w-full h-full object-cover object-top" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-br from-zinc-900/40 to-zinc-900/10 opacity-80 group-hover:opacity-40 transition-opacity"></div>
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(251,146,60,0.12),transparent_40%)] opacity-80 group-hover:opacity-40 transition-opacity"></div>
              </div>
            ) : i === 5 ? (
              <div class="relative h-52 rounded-xl border border-white/10 mb-4 overflow-hidden">
                <img src="/images/leadcrusade.png" alt="Lead Crusade site preview" class="w-full h-full object-cover object-top" loading="lazy" />
                <div class="absolute inset-0 bg-gradient-to-br from-zinc-900/40 to-zinc-900/10 opacity-80 group-hover:opacity-40 transition-opacity"></div>
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(251,146,60,0.12),transparent_40%)] opacity-80 group-hover:opacity-40 transition-opacity"></div>
              </div>
            ) : (
              <div class="relative h-44 rounded-xl border border-white/10 bg-gradient-to-br from-zinc-800/60 to-zinc-900/60 mb-4 overflow-hidden">
                <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(251,146,60,0.12),transparent_40%)]"></div>
                <div class="absolute bottom-2 right-2 text-[10px] px-2 py-1 rounded-full bg-white/10 border border-white/10 text-zinc-300">Mock</div>
              </div>
            )}
            <div class="px-2 pb-2">
              <h3 class="text-lg font-semibold mb-1 text-white">
                {i === 0
                  ? 'Honkpill'
                  : i === 1
                  ? 'Real Estate'
                  : i === 2
                  ? 'Tempting Design'
                  : i === 3
                  ? 'Gondola Adventure Club'
                  : i === 4
                  ? 'Hough Chiropractic'
                  : i === 5
                  ? 'Lead Crusade'
                  : `Project Title ${i + 1}`}
              </h3>
              <p class="text-sm text-zinc-400 mb-3">Modern, fast, and mobile‑first with clear calls to action.</p>
              <div class="flex flex-wrap gap-2 mb-3">
                <span class="px-2 py-1 text-[11px] rounded bg-white/5 border border-white/10 text-zinc-300">Design</span>
                <span class="px-2 py-1 text-[11px] rounded bg-white/5 border border-white/10 text-zinc-300">Build</span>
                <span class="px-2 py-1 text-[11px] rounded bg-white/5 border border-white/10 text-zinc-300">Local SEO</span>
              </div>
              <ul class="text-[12px] text-zinc-400 space-y-1">
                <li class="flex gap-2"><span class="text-orange-400">•</span> Clear service pages and CTAs</li>
                <li class="flex gap-2"><span class="text-orange-400">•</span> Lightweight animations</li>
                <li class="flex gap-2"><span class="text-orange-400">•</span> Fast on mobile</li>
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Process strip -->
    <section class="max-w-7xl mx-auto mt-12 border-t border-white/5 pt-8 md:pt-12 mesh-gradient py-8 md:py-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-6 fade-in-up text-balance">How We Deliver</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        <div class="framer-card p-6 rounded-2xl fade-in-up stagger-1 group">
          <div class="w-7 h-7 rounded-full bg-orange-600/20 border border-orange-500/30 text-orange-300 flex items-center justify-center mb-3 group-hover:bg-orange-500/30 group-hover:scale-110 transition-all font-semibold">1</div>
          <h3 class="font-semibold mb-2">Plan</h3>
          <p class="text-sm text-zinc-400">Sitemap, content, and goals aligned.</p>
        </div>
        <div class="framer-card p-6 rounded-2xl fade-in-up stagger-2 group">
          <div class="w-7 h-7 rounded-full bg-orange-600/20 border border-orange-500/30 text-orange-300 flex items-center justify-center mb-3 group-hover:bg-orange-500/30 group-hover:scale-110 transition-all font-semibold">2</div>
          <h3 class="font-semibold mb-2">Design</h3>
          <p class="text-sm text-zinc-400">Visual concepts refined together.</p>
        </div>
        <div class="framer-card p-6 rounded-2xl fade-in-up stagger-3 group">
          <div class="w-7 h-7 rounded-full bg-orange-600/20 border border-orange-500/30 text-orange-300 flex items-center justify-center mb-3 group-hover:bg-orange-500/30 group-hover:scale-110 transition-all font-semibold">3</div>
          <h3 class="font-semibold mb-2">Build</h3>
          <p class="text-sm text-zinc-400">Clean, fast implementation and QA.</p>
        </div>
        <div class="framer-card p-6 rounded-2xl fade-in-up stagger-4 group">
          <div class="w-7 h-7 rounded-full bg-orange-600/20 border border-orange-500/30 text-orange-300 flex items-center justify-center mb-3 group-hover:bg-orange-500/30 group-hover:scale-110 transition-all font-semibold">4</div>
          <h3 class="font-semibold mb-2">Launch</h3>
          <p class="text-sm text-zinc-400">Testing, deploy, and smooth handoff.</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <div class="text-center mt-12 md:mt-16 border-t border-white/5 pt-8 md:pt-12 mesh-gradient py-8 md:py-12 fade-in-up">
      <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
        <a href="mailto:info@example.com" class="w-full sm:w-auto px-8 md:px-10 py-4 md:py-5 bg-orange-600 text-white font-bold rounded-full hover:bg-orange-500 transition-all text-base md:text-lg btn-glow relative hover:scale-105 min-h-[44px] flex items-center justify-center">
          Request a free consult
        </a>
        <a href="/services" class="w-full sm:w-auto px-8 md:px-10 py-4 md:py-5 bg-white/5 text-white font-bold rounded-full border border-white/10 hover:bg-white/10 transition-all hover:border-white/20 text-base md:text-lg min-h-[44px] flex items-center justify-center">
          Our services
        </a>
      </div>
      <p class="text-zinc-500 text-sm mt-3 text-balance">Prefer a call? Add your number in the email.</p>
    </div>
  </main>
</MainLayout>


