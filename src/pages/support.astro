---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="WordPress Support | Lake Forest Websites" bodyClass="page-support">
  <link rel="stylesheet" href="/css/pages/support.css" />

  <!-- Hero -->
  <header class="relative pt-32 md:pt-40 pb-12 md:pb-16 px-4 md:px-6 text-center">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] glow-bg pointer-events-none opacity-40"></div>
    <div class="max-w-5xl mx-auto relative">
      <div class="hero-content inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-medium text-orange-400 mb-6 backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
        WordPress Support
      </div>
      <h1 class="hero-content text-3xl md:text-6xl font-bold tracking-tight mb-4 text-balance" style="animation-delay: 0.1s">
        Real Support by <span class="text-gradient-orange">Real Experts</span>
      </h1>
      <p class="hero-content text-zinc-400 text-base md:text-lg leading-relaxed px-2 md:px-0" style="animation-delay: 0.2s">
        From urgent fixes to routine updates, we keep your WordPress site secure, current, and performing at its best.
      </p>
    </div>
  </header>

  <main class="pb-16 md:pb-24 px-4 md:px-6">
    <!-- What we handle -->
    <section class="max-w-7xl mx-auto border-t border-white/5 pt-8 md:pt-12 mesh-gradient py-8 md:py-12">
      <div class="grid md:grid-cols-3 gap-4 md:gap-6">
        <div class="framer-card p-8 rounded-2xl fade-in-up stagger-1 group">
          <div class="w-10 h-10 rounded-xl bg-orange-500/15 border border-orange-500/20 flex items-center justify-center mb-4 group-hover:bg-orange-500/25 group-hover:scale-110 transition-all">
            <svg class="w-5 h-5 text-orange-400 group-hover:text-orange-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h10"/></svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Fixes & Troubleshooting</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Broken layouts, errors, plugin conflicts—we diagnose and resolve issues the right way.</p>
        </div>
        <div class="framer-card p-8 rounded-2xl fade-in-up stagger-2 group">
          <div class="w-10 h-10 rounded-xl bg-orange-500/15 border border-orange-500/20 flex items-center justify-center mb-4 group-hover:bg-orange-500/25 group-hover:scale-110 transition-all">
            <svg class="w-5 h-5 text-orange-400 group-hover:text-orange-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m6-6H6"/></svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Content & Design Updates</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Service changes, new pages, photo swaps, layout tweaks, and accessibility improvements.</p>
        </div>
        <div class="framer-card p-8 rounded-2xl fade-in-up stagger-3 group">
          <div class="w-10 h-10 rounded-xl bg-orange-500/15 border border-orange-500/20 flex items-center justify-center mb-4 group-hover:bg-orange-500/25 group-hover:scale-110 transition-all">
            <svg class="w-5 h-5 text-orange-400 group-hover:text-orange-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="text-xl font-semibold mb-2">Feature Enhancements</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Add functionality or refine what’s there—forms, maps, integrations, and more.</p>
        </div>
      </div>
    </section>

    <!-- Why dedicated WP support -->
    <section class="max-w-7xl mx-auto mt-8 md:mt-12 border-t border-white/5 pt-8 md:pt-12">
      <div class="grid md:grid-cols-2 gap-4 md:gap-6">
        <div class="framer-card p-8 rounded-2xl fade-in-up stagger-1">
          <h3 class="text-xl font-semibold mb-2">Why Dedicated WordPress Support</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">WordPress powers a large share of the web. We focus on it—core updates, plugin hygiene, and conflict‑free changes—so your site stays stable and fast.</p>
        </div>
        <div class="framer-card p-8 rounded-2xl fade-in-up stagger-2">
          <h3 class="text-xl font-semibold mb-2">Experts That Don’t Waste Time</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">No ticket mills or canned replies. You’ll work with technicians who solve problems quickly and communicate clearly.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="max-w-7xl mx-auto mt-12 border-t border-white/5 pt-8 md:pt-12 mesh-gradient py-8 md:py-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-6 text-balance">Frequently Asked Questions</h2>
      <div class="grid md:grid-cols-2 gap-4 md:gap-6">
        <div class="framer-card p-6 rounded-2xl fade-in-up stagger-1">
          <h3 class="font-semibold mb-2">Do you support sites you didn’t build?</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Yes, most WordPress sites are eligible. Work is subject to minimum fees and availability.</p>
        </div>
        <div class="framer-card p-6 rounded-2xl fade-in-up stagger-2">
          <h3 class="font-semibold mb-2">Is there an upfront fee?</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">We take a small deposit to begin diagnosis or troubleshooting. Minimum service fees apply.</p>
        </div>
        <div class="framer-card p-6 rounded-2xl fade-in-up stagger-3">
          <h3 class="font-semibold mb-2">Can you help with changes?</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Absolutely—content updates, design improvements, new features, and more.</p>
        </div>
        <div class="framer-card p-6 rounded-2xl fade-in-up stagger-4">
          <h3 class="font-semibold mb-2">Do you offer emergency help?</h3>
          <p class="text-sm text-zinc-400 leading-relaxed">Priority emergency support is available for existing clients; new clients are scheduled ASAP.</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="text-center mt-12 md:mt-16 border-t border-white/5 pt-8 md:pt-12 mesh-gradient py-8 md:py-12 fade-in-up">
      <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
        <a href="/contact" class="w-full sm:w-auto px-8 md:px-10 py-4 md:py-5 bg-orange-600 text-white font-bold rounded-full hover:bg-orange-500 transition-all text-base md:text-lg btn-glow relative hover:scale-105 min-h-[44px] flex items-center justify-center">
          Request support
        </a>
        <a href="/hosting" class="w-full sm:w-auto px-8 md:px-10 py-4 md:py-5 bg-white/5 text-white font-bold rounded-full border border-white/10 hover:bg-white/10 transition-all hover:border-white/20 text-base md:text-lg min-h-[44px] flex items-center justify-center">
          Managed hosting
        </a>
      </div>
      <p class="text-zinc-500 text-sm mt-3 text-balance">Prefer a call? Add your number in the email.</p>
    </section>
  </main>
</MainLayout>


