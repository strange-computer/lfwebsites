---
interface Props {
  title?: string;
  bodyClass?: string;
}
import '../styles/global.css';
const { title = 'Lake Forest Websites', bodyClass = '' } = Astro.props;
// Highlight active nav link based on current path
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const navClass = (href: string) =>
  `hover:text-white transition-colors ${currentPath === href || (href !== '/' && currentPath.startsWith(href)) ? 'text-white' : ''}`;
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Existing layered CSS -->
    <link rel="stylesheet" href="/css/layers.css" />
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/components.css" />
  </head>
  <body class={`antialiased overflow-x-hidden selection:bg-orange-500 selection:text-white ${bodyClass}`}>
    <!-- Scroll Progress Indicator -->
    <div class="scroll-progress" id="scrollProgress"></div>
    
    <nav class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-black/30 backdrop-blur-xl backdrop-saturate-150 shadow-[0_8px_32px_rgba(0,0,0,0.35)] ring-1 ring-white/10 transition-all duration-300" id="mainNav">
      <div class="max-w-7xl mx-auto px-4 md:px-6 h-16 md:h-20 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 bg-orange-600 rounded-lg flex items-center justify-center font-bold text-white">
            LF
          </div>
          <a href="/" class="font-semibold text-base md:text-lg tracking-tight hover:text-white/80 transition">Lake Forest Websites</a>
        </div>
        <div class="hidden md:flex items-center gap-8 text-sm font-medium text-zinc-400">
          <a href="/services" class={navClass('/services')}>Services</a>
          <a href="/industries" class={navClass('/industries')}>Industries</a>
          <a href="/portfolio" class={navClass('/portfolio')}>Portfolio</a>
          <a href="/support" class={navClass('/support')}>Support</a>
          <a href="/hosting" class={navClass('/hosting')}>Hosting</a>
          <a href="/reviews" class={navClass('/reviews')}>Reviews</a>
          <a href="/about" class={navClass('/about')}>About</a>
          <a href="/contact" class={navClass('/contact')}>Contact</a>
        </div>
        <div class="flex items-center gap-3">
          <a href="tel:5555551234" class="md:hidden px-4 py-2 bg-orange-600 text-white text-xs font-semibold rounded-full hover:bg-orange-500 transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center">
            Call
          </a>
          <a href="#" class="hidden md:block px-5 py-2.5 bg-white text-black text-sm font-semibold rounded-full hover:bg-zinc-200 transition-colors">
            (555) 555-1234
          </a>
          <button id="mobileMenuBtn" class="md:hidden p-2 text-zinc-400 hover:text-white transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center" aria-label="Open menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </div>
    </nav>

    <!-- Mobile Menu Overlay -->
    <div id="mobileMenuOverlay" class="mobile-menu-overlay">
      <div class="mobile-menu-content">
        <div class="flex items-center justify-between mb-8">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 bg-orange-600 rounded-lg flex items-center justify-center font-bold text-white">
              LF
            </div>
            <span class="font-semibold text-lg">Menu</span>
          </div>
          <button id="mobileMenuClose" class="p-2 text-zinc-400 hover:text-white transition-colors min-h-[44px] min-w-[44px] flex items-center justify-center" aria-label="Close menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <nav class="flex flex-col gap-1 mb-8">
          <a href="/services" class={`mobile-nav-link ${navClass('/services')}`}>Services</a>
          <a href="/industries" class={`mobile-nav-link ${navClass('/industries')}`}>Industries</a>
          <a href="/portfolio" class={`mobile-nav-link ${navClass('/portfolio')}`}>Portfolio</a>
          <a href="/support" class={`mobile-nav-link ${navClass('/support')}`}>Support</a>
          <a href="/hosting" class={`mobile-nav-link ${navClass('/hosting')}`}>Hosting</a>
          <a href="/reviews" class={`mobile-nav-link ${navClass('/reviews')}`}>Reviews</a>
          <a href="/about" class={`mobile-nav-link ${navClass('/about')}`}>About</a>
          <a href="/contact" class={`mobile-nav-link ${navClass('/contact')}`}>Contact</a>
        </nav>
        <a href="tel:5555551234" class="block w-full px-6 py-4 bg-orange-600 text-white font-semibold rounded-xl text-center hover:bg-orange-500 transition-colors btn-glow min-h-[44px] flex items-center justify-center">
          (555) 555-1234
        </a>
      </div>
    </div>

    <slot />

    <script>
      // Scroll progress indicator
      (() => {
        const progressBar = document.getElementById('scrollProgress');
        if (!progressBar) return;
        
        function updateProgress() {
          const windowHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          const scrolled = (window.scrollY / windowHeight) * 100;
          progressBar.style.width = scrolled + '%';
        }
        
        window.addEventListener('scroll', updateProgress);
        updateProgress();
      })();

      // Navbar scroll effect
      (() => {
        const nav = document.getElementById('mainNav');
        if (!nav) return;
        
        let lastScroll = 0;
        window.addEventListener('scroll', () => {
          const currentScroll = window.scrollY;
          
          if (currentScroll > 100) {
            nav.classList.add('bg-black/50');
            nav.classList.remove('bg-black/30');
          } else {
            nav.classList.add('bg-black/30');
            nav.classList.remove('bg-black/50');
          }
          
          lastScroll = currentScroll;
        });
      })();

      // Intersection Observer for scroll animations
      (() => {
        const observerOptions = {
          threshold: 0.1,
          rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              // Optionally unobserve after animation
              // observer.unobserve(entry.target);
            }
          });
        }, observerOptions);

        // Observe all elements with animation classes
        document.querySelectorAll('.fade-in-up, .fade-in, .scale-in').forEach(el => {
          observer.observe(el);
        });
      })();

      // Mobile Menu Toggle
      (() => {
        const menuBtn = document.getElementById('mobileMenuBtn');
        const menuClose = document.getElementById('mobileMenuClose');
        const menuOverlay = document.getElementById('mobileMenuOverlay');
        const body = document.body;

        if (!menuBtn || !menuClose || !menuOverlay) return;

        function openMenu() {
          menuOverlay.classList.add('mobile-menu-open');
          body.classList.add('no-scroll');
        }

        function closeMenu() {
          menuOverlay.classList.remove('mobile-menu-open');
          body.classList.remove('no-scroll');
        }

        menuBtn.addEventListener('click', openMenu);
        menuClose.addEventListener('click', closeMenu);
        menuOverlay.addEventListener('click', (e) => {
          if (e.target === menuOverlay) {
            closeMenu();
          }
        });

        // Close menu when clicking on nav links
        const navLinks = menuOverlay.querySelectorAll('.mobile-nav-link');
        navLinks.forEach(link => {
          link.addEventListener('click', closeMenu);
        });

        // Close menu on escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menuOverlay.classList.contains('mobile-menu-open')) {
            closeMenu();
          }
        });
      })();
    </script>

    <footer class="border-t border-white/10 py-8 md:py-12 px-4 md:px-6 bg-black">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="text-zinc-500 text-sm">© 2025 Lake Forest Websites. All Rights Reserved.</div>
        <div class="flex gap-6 text-sm text-zinc-400">
          <a href="/" class="hover:text-white">Home</a>
          <a href="/services" class="hover:text-white">Services</a>
          <a href="/about" class="hover:text-white">About</a>
        </div>
      </div>
    </footer>
  </body>
  <!-- Per-page CSS layers can be added by the page (e.g., /css/pages/home.css) -->
</html>


